rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function hasStaffDoc() {
      return signedIn() && exists(/databases/$(db)/documents/staff/$(request.auth.uid))
        && get(/databases/$(db)/documents/staff/$(request.auth.uid)).data.get('active', true) != false;
    }
    function staffRole() {
      return get(/databases/$(db)/documents/staff/$(request.auth.uid)).data.role;
    }
    function isStaff() { return hasStaffDoc() && staffRole() in ['admin', 'owner', 'manager', 'staff', 'waiter', 'cashier', 'chef']; }
    function isAdmin() { return hasStaffDoc() && staffRole() in ['admin', 'owner', 'manager']; }
    function isAdminOrOwner() { return hasStaffDoc() && staffRole() in ['admin', 'owner']; }
    function validStaffProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.role in ['admin', 'owner', 'manager', 'staff', 'waiter', 'cashier', 'chef', 'delivery']
        && (!('active' in d) || d.active is bool)
        && (!('monthlySalary' in d)
          || (d.monthlySalary is number && d.monthlySalary >= 0 && d.monthlySalary <= 100000000));
    }
    function validSalaryCarryForward() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'staffId', 'fromMonth', 'month', 'amount', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
          'cancelledAt', 'cancelledBy'
        ])
        && d.keys().hasAll([
          'staffId', 'fromMonth', 'month', 'amount', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && d.staffId is string
        && exists(/databases/$(db)/documents/staff/$(d.staffId))
        && d.fromMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.amount is number && d.amount > 0
        && d.status in ['active', 'cancelled']
        && d.createdBy is string
        && d.createdAt is int
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid
        && (d.status != 'cancelled'
          || (d.cancelledBy == request.auth.uid && d.cancelledAt is int));
    }
    function restaurantRadius() {
      return exists(/databases/$(db)/documents/settings/restaurant)
        ? get(/databases/$(db)/documents/settings/restaurant).data.radius
        : 100;
    }

    // 🔥 NEW — delivery boy
    function isDelivery() { return hasStaffDoc() && staffRole() == 'delivery'; }

    function ownsOrder(orderId) {
      return signedIn()
        && exists(/databases/$(db)/documents/orders/$(orderId))
        && get(/databases/$(db)/documents/orders/$(orderId)).data.createdBy == request.auth.uid;
    }
    // Waiter/staff (admin/owner/manager nahi) ke liye: console se bhi ye 3 cheezein nahi ho sakti
    //  - paid order ko unpaid karna (Undo Paid sirf owner)
    //  - cancelled order ko wapas chalu karna (Restore sirf owner)
    //  - discount % badhana (discount sirf owner)
    function staffEditOk() {
      let before = resource.data;
      let after = request.resource.data;
      return !(before.get('paid', false) == true && after.get('paid', false) != true)
        && !(before.get('status', '') == 'cancelled' && after.get('status', '') != 'cancelled')
        && after.get('billDiscountPct', 0) <= before.get('billDiscountPct', 0);
    }
    function staffCreateOk() {
      return request.resource.data.get('billDiscountPct', 0) == 0;
    }
    function validCustomerOrder() {
      let d = request.resource.data;
      return d.status == 'new'
        && d.paid == false
        && d.orderType in ['dine_in', 'parcel']
        && d.table is int && d.table >= 0 && d.table <= 20
        && d.items is list && d.items.size() > 0 && d.items.size() <= 40
        && d.finalTotal is number && d.finalTotal >= 0 && d.finalTotal <= 100000
        && (!('discount' in d) || (d.discount is number && d.discount >= 0 && d.discount <= 50))
        && (!('paymentStatus' in d) || d.paymentStatus in ['pending', 'paid_unverified'])
        && d.keys().size() <= 60;
    }

    match /staff/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'role', 'monthlySalary', 'active'])
        && request.resource.data.keys().hasOnly(['name', 'role', 'monthlySalary', 'active'])
        && validStaffProfile();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'role', 'monthlySalary', 'active'])
        && validStaffProfile();
      allow delete: if false;
    }

    match /staffPayroll/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'monthlySalary', 'updatedAt', 'updatedBy'])
        && request.resource.data.uid == uid
        && request.resource.data.monthlySalary is number
        && request.resource.data.monthlySalary >= 0
        && request.resource.data.monthlySalary <= 100000000
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /staffAdvances/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdminOrOwner()
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'month', 'status', 'createdAt', 'approvedBy'])
        && request.resource.data.uid is string
        && exists(/databases/$(db)/documents/staff/$(request.resource.data.uid))
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.status == 'approved'
        && request.resource.data.createdAt is int
        && request.resource.data.approvedBy == request.auth.uid;
      allow update: if isAdminOrOwner();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if (docId != 'privatePins' && docId != 'presets')
                  || (docId == 'presets' && isStaff())
                  || isAdmin();
      allow write: if (isAdmin()
                    && (docId != 'restaurant'
                      || (request.resource.data.keys().hasOnly(['lat', 'lng', 'radius'])
                        && request.resource.data.keys().hasAll(['lat', 'lng', 'radius'])
                        && request.resource.data.lat is number
                        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                        && request.resource.data.lng is number
                        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
                        && request.resource.data.radius is number
                        && request.resource.data.radius > 0 && request.resource.data.radius <= 10000)))
                  || (isStaff() && docId in ['menu', 'availability', 'favourites', 'expenseCats']);
    }

    match /advances/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('staffId', resource.data.get('uid', '')) == request.auth.uid);
      allow create: if ((isStaff() || isDelivery())
          && request.resource.data.keys().hasOnly([
            'staffId', 'uid', 'staffName', 'name', 'amount', 'reason', 'note',
            'status', 'createdAt', 'month', 'date', 'source'
          ])
          && request.resource.data.keys().hasAny(['staffId', 'uid'])
          && request.resource.data.get('staffId', request.auth.uid) == request.auth.uid
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
          && request.resource.data.status == 'Pending'
          && request.resource.data.createdAt is int
          && (!('month' in request.resource.data)
            || request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'))
          && (!('date' in request.resource.data)
            || request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!('source' in request.resource.data) || request.resource.data.source == 'request'))
        || (isAdminOrOwner()
          && request.resource.data.keys().hasOnly([
            'staffId', 'staffName', 'amount', 'date', 'month', 'note', 'reason',
            'source', 'status', 'createdAt', 'approvedBy', 'approvedAt'
          ])
          && request.resource.data.keys().hasAll([
            'staffId', 'staffName', 'amount', 'date', 'month', 'source',
            'status', 'createdAt', 'approvedBy', 'approvedAt'
          ])
          && request.resource.data.staffId is string
          && exists(/databases/$(db)/documents/staff/$(request.resource.data.staffId))
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.source == 'manual'
          && request.resource.data.status == 'Approved'
          && request.resource.data.createdAt is int
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt is int);
      allow update: if isAdminOrOwner()
        && ((resource.data.status == 'Pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'adminNote'])
          && request.resource.data.status in ['Approved', 'Rejected']
          && (request.resource.data.status != 'Approved'
            || (request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt is int))
          && (request.resource.data.status != 'Rejected'
            || (request.resource.data.rejectedBy == request.auth.uid && request.resource.data.rejectedAt is int))
          && (!('adminNote' in request.resource.data) || request.resource.data.adminNote is string))
        || (resource.data.status in ['Pending', 'pending', 'Approved', 'approved', 'Rejected', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledBy', 'cancelledAt'])
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt is int));
      allow delete: if false;
    }

    match /salaryPayments/{id} {
      allow read: if isAdmin();
      allow create: if isAdminOrOwner()
        && request.resource.data.keys().hasOnly([
          'staffId', 'month', 'amount', 'date', 'note', 'createdBy', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'staffId', 'month', 'amount', 'date', 'note', 'createdBy', 'createdAt', 'status'
        ])
        && request.resource.data.staffId is string
        && exists(/databases/$(db)/documents/staff/$(request.resource.data.staffId))
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.status == 'paid';
      allow update: if isAdminOrOwner()
        && resource.data.status != 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledBy', 'cancelledAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt is int;
      allow delete: if false;
    }

    match /salaryCarryForwards/{id} {
      allow read: if isAdmin();
      allow create: if isAdminOrOwner()
        && validSalaryCarryForward()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdminOrOwner()
        && validSalaryCarryForward()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['amount', 'status', 'updatedAt', 'updatedBy', 'cancelledAt', 'cancelledBy']);
      allow delete: if false;
    }

    match /leaveRequests/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.staffId == request.auth.uid);
      allow create: if (isStaff() || isDelivery())
        && request.resource.data.keys().hasOnly([
          'staffId', 'staffName', 'fromDate', 'toDate', 'type', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'staffId', 'staffName', 'fromDate', 'toDate', 'type', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.staffId == request.auth.uid
        && request.resource.data.staffName is string
        && request.resource.data.fromDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.toDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fromDate <= request.resource.data.toDate
        && request.resource.data.type in ['Paid Leave', 'Unpaid Leave', 'Half Day']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int;
      allow update: if (isAdminOrOwner()
          && resource.data.status in ['pending', 'approved']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminNote', 'decidedBy', 'decidedAt', 'cancelledBy', 'cancelledAt'])
          && request.resource.data.status in ['approved', 'rejected', 'cancelled']
          && (!('adminNote' in request.resource.data) || request.resource.data.adminNote is string)
          && (request.resource.data.status == 'cancelled'
            ? (request.resource.data.cancelledBy == request.auth.uid && request.resource.data.cancelledAt is int)
            : (request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt is int)))
        || ((isStaff() || isDelivery())
          && resource.data.staffId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt is int);
      allow delete: if false;
    }

    match /attendance/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.staffId == request.auth.uid);
      allow create: if (isAdminOrOwner()
        && request.resource.data.keys().hasOnly(['staffId', 'date', 'status', 'markedBy', 'source', 'leaveRequestId'])
        && request.resource.data.keys().hasAll(['staffId', 'date', 'status', 'markedBy', 'source'])
        && request.resource.data.staffId is string
        && exists(/databases/$(db)/documents/staff/$(request.resource.data.staffId))
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['Present', 'Half Day', 'Absent', 'Paid Leave']
        && request.resource.data.markedBy == 'Admin'
        && (request.resource.data.source == 'manual'
          || (request.resource.data.source == 'leave'
            && request.resource.data.keys().hasAll(['leaveRequestId'])
            && request.resource.data.leaveRequestId is string
            && exists(/databases/$(db)/documents/leaveRequests/$(request.resource.data.leaveRequestId)))))
        || ((isStaff() || isDelivery())
          && request.resource.data.keys().hasOnly(['staffId', 'date', 'status', 'distanceMeters', 'source'])
          && request.resource.data.keys().hasAll(['staffId', 'date', 'status', 'distanceMeters'])
          && request.resource.data.staffId == request.auth.uid
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.status == 'Present'
          && (!('source' in request.resource.data) || request.resource.data.source == 'gps')
          && request.resource.data.distanceMeters is number
          && request.resource.data.distanceMeters >= 0
          && request.resource.data.distanceMeters <= restaurantRadius());
      allow update: if isAdminOrOwner()
        && request.resource.data.keys().hasOnly(['staffId', 'date', 'status', 'markedBy', 'source', 'leaveRequestId'])
        && request.resource.data.keys().hasAll(['staffId', 'date', 'status', 'markedBy', 'source'])
        && request.resource.data.staffId is string
        && exists(/databases/$(db)/documents/staff/$(request.resource.data.staffId))
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['Present', 'Half Day', 'Absent', 'Paid Leave']
        && request.resource.data.markedBy == 'Admin'
        && (request.resource.data.source == 'manual'
          || (request.resource.data.source == 'leave'
            && request.resource.data.keys().hasAll(['leaveRequestId'])
            && request.resource.data.leaveRequestId is string
            && exists(/databases/$(db)/documents/leaveRequests/$(request.resource.data.leaveRequestId))));
      allow delete: if isAdminOrOwner()
        || ((isStaff() || isDelivery())
          && resource.data.staffId == request.auth.uid
          && resource.data.source == 'leave'
          && exists(/databases/$(db)/documents/leaveRequests/$(resource.data.leaveRequestId))
          && get(/databases/$(db)/documents/leaveRequests/$(resource.data.leaveRequestId)).data.staffId == request.auth.uid
          && get(/databases/$(db)/documents/leaveRequests/$(resource.data.leaveRequestId)).data.status == 'pending');
    }

    // ============================================================
    // ✅ FIXED — Delivery + customer cancel
    // ============================================================
    match /orders/{id} {
      allow create: if signedIn()
        && id.matches('^o[a-z0-9]{6,40}$')
        && request.resource.data.createdBy == request.auth.uid
        && ((isStaff() && (isAdmin() || staffCreateOk())) || validCustomerOrder());

      allow read: if isStaff()
        || (isDelivery() && resource.data.orderType == 'parcel')
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      allow update: if (isStaff() && (isAdmin() || staffEditOk()))
        || (isDelivery() && resource.data.orderType == 'parcel'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'paid', 'paymentStatus', 'deliveredAt', 'deliveredBy'])
            && request.resource.data.status in ['out_for_delivery', 'served']
            && (request.resource.data.status != 'out_for_delivery'
                || resource.data.status == 'ready')
            && (request.resource.data.status != 'served'
                || resource.data.status == 'out_for_delivery'))
        || (signedIn() && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'new' && resource.data.paid == false
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelledAt', 'cancelledBy'])
            && request.resource.data.status == 'cancelled');

      allow delete: if isAdmin();
    }

    // ============================================================
    // ✅ FIXED — Customer khud apna doc padh/bana/update kar sake
    // ============================================================
    match /customers/{phone} {
      allow read: if isStaff()
        || (signedIn() && request.auth.token.phone_number == '+91' + phone);
      allow create, update: if isStaff()
        || (signedIn() && request.auth.token.phone_number == '+91' + phone);
    }

    match /loyaltyUsers/{phone} {
      allow get: if isStaff() || (signedIn() && request.auth.token.phone_number == '+91' + phone);
      allow list, write: if isStaff();
    }

    match /coinHistory/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /calls/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'active'
        && request.resource.data.table is int
        && request.resource.data.table >= 1 && request.resource.data.table <= 20
        && request.resource.data.keys().size() <= 6;
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().size() <= 12
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow read, update, delete: if isStaff();
    }

    match /chats/{orderId}/messages/{msgId} {
      allow read: if isStaff() || ownsOrder(orderId);
      allow create: if (isStaff() || ownsOrder(orderId) || (signedIn() && orderId.matches('^general_.{1,15}$')))
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    match /inventory/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() || (isStaff() && id != 'items');
    }

    match /expenses/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /vendors/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /vendorPayments/{id} { allow read, write: if isAdmin(); }
    match /dayClose/{id}       { allow read, write: if isAdmin(); }
    match /feedback/{id} {
      allow create: if isStaff() || signedIn();
      allow read: if isAdmin();
    }

    match /couponUsage/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    match /staffAttendance/{id} {
      allow read: if isAdmin() || ((isStaff() || isDelivery()) && resource.data.uid == request.auth.uid);
      allow create: if (isStaff() || isDelivery())
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'action', 'at', 'date', 'distanceMeters'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.role is string
        && request.resource.data.action in ['login', 'logout', 'present']
        && request.resource.data.at is int
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.action != 'present'
          || (request.resource.data.distanceMeters is number
            && request.resource.data.distanceMeters >= 0
            && request.resource.data.distanceMeters <= restaurantRadius()));
      allow update, delete: if isAdmin();
    }
  }
}